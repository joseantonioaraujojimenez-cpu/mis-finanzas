{
  "name": "mis-finanzas-faceid-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"FACEID_TEST_MODE":"enabled"},
  "assets": {"directory":"./faceid-test","binding":"TEST_ASSETS","run_worker_first":true,"html_handling":"none"},
  "durable_objects": {"bindings":[{"name":"PASSKEY_COORDINATOR","class_name":"PasskeyCoordinator"}]},
  "migrations":[{"tag":"v1-faceid-test","new_sqlite_classes":["PasskeyCoordinator"]}]
}
